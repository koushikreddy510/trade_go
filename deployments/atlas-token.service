[Unit]
Description=Atlas daily Flattrade session token job
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atlas
EnvironmentFile=/opt/atlas/.env
Environment=ATLAS_CONFIG=/opt/atlas/configs/atlas.paper.yaml
Environment=ATLAS_BIN=/opt/atlas/bin/atlas
ExecStart=/opt/atlas/scripts/daily-session-token.sh
User=atlas
