# Flattrade Wall credentials (created once; NOT the daily jKey)
# API key + secret stay static. jKey (session token) is exchanged daily via OAuth.
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_CLIENT_ID=

# Redis connection
REDIS_ADDR=localhost:6379

# Atlas configuration file path
# Local SIMULATION+Redis: configs/atlas.dev.yaml
# Paper/VM:               configs/atlas.paper.yaml
ATLAS_CONFIG=configs/atlas.dev.yaml
